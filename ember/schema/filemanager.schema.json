{
  "$comment": "filemanager 模块：媒体库。外壳设一个目录，核心实时监视（按文件夹列出全部子文件夹与全部文件，不分扩展名、含隐藏文件，免得文件夹看上去是空的而被误删；其中软盘镜像、nes、png 与录音机支持的音频是支持的种类，其他标为不支持，只能重命名、移动、复制、删除），界面展开哪个文件夹才读哪个文件夹，不读文件内容；打开软盘镜像时才识别它的文件系统（FAT12/16、Apple DOS 3.3、ProDOS；.nib、.woz 只读），并对镜像里的文件做列出、重命名、删除、移动、新建文件夹、导入、导出、撤销，以及新建空白镜像；镜像插在软驱里时改的是软驱里的盘片（立即生效，随后写回文件），否则直接改文件。规则见 docs/04-调试服务.md 第 4.10 节。",
  "module": "filemanager",
  "types": {
    "ImageNode": {
      "type": "object",
      "description": "目录树里的一个节点：文件（软盘镜像、卡带、音频、图片、不支持的文件）或文件夹。",
      "properties": {
        "path": { "type": "string", "description": "相对目录的路径，用 / 分隔，不以 / 开头" },
        "name": { "type": "string", "description": "完整的文件名或文件夹名" },
        "directory": { "type": "boolean", "description": "是否是文件夹" },
        "kind": { "type": "string", "description": "种类：folder（文件夹）、floppy（软盘镜像）、cartridge（nes 卡带）、audio（录音机支持的音频）、picture（png 图片）、unsupported（其他文件，包括隐藏文件与符号链接）" },
        "size": { "type": "integer", "minimum": 0, "description": "文件的大小（字节）；文件夹为 0" },
        "formatName": { "type": "string", "description": "界面显示的文件种类名称：NES 卡带、PNG 图片、MP3 音频这样的名称，不支持的文件是“不支持”；文件夹与软盘镜像为空（软盘镜像的文件系统格式在 filemanager.list 的 fileSystem 里）" }
      },
      "required": ["path", "name", "directory", "kind", "size", "formatName"]
    },
    "FileSystemInfo": {
      "type": "object",
      "description": "一个镜像的文件系统。",
      "properties": {
        "format": { "type": "string", "description": "格式标识：fat12、fat16、appledos33、prodos" },
        "formatName": { "type": "string", "description": "界面显示的格式名称" },
        "writable": { "type": "boolean", "description": "能否修改文件系统里的内容" },
        "subdirectories": { "type": "boolean", "description": "有没有子目录：没有时不能新建文件夹，也不能移动文件" }
      },
      "required": ["format", "formatName", "writable", "subdirectories"]
    },
    "EntryInfo": {
      "type": "object",
      "description": "镜像里的一个文件或文件夹。",
      "properties": {
        "name": { "type": "string", "description": "完整名称" },
        "directory": { "type": "boolean", "description": "是否是文件夹" },
        "type": { "type": "string", "description": "类型文字：FAT 是扩展名，DOS 3.3 与 ProDOS 是类型名，文件夹是“文件夹”" },
        "size": { "type": "integer", "minimum": 0, "description": "大小（字节）；文件夹为 0" },
        "sizeIsAllocated": { "type": "boolean", "description": "大小是占用的空间而不是准确的字节数（DOS 3.3 只知道占用的扇区数）" },
        "modified": { "type": "string", "description": "修改时间，形如 2026-11-25 14:30；文件系统没有时间时为空" },
        "locked": { "type": "boolean", "description": "只读或锁定的标记，只作显示" }
      },
      "required": ["name", "directory", "type", "size", "sizeIsAllocated", "modified", "locked"]
    },
    "BlankKind": {
      "type": "object",
      "description": "一种能新建的空白镜像。",
      "properties": {
        "id": { "type": "string", "description": "标识：fat1440、fat720、fat2880、fat1200、fat360、appledos33、prodos、pyramid" },
        "title": { "type": "string", "description": "界面显示的名称" },
        "extension": { "type": "string", "description": "新建文件的扩展名，不带点" }
      },
      "required": ["id", "title", "extension"]
    },
    "ExportItem": {
      "type": "object",
      "description": "导出的一个文件或文件夹。",
      "properties": {
        "path": { "type": "array", "items": { "type": "string" }, "description": "在导出的内容里的路径：第一项是选中条目的 Windows 文件名，其后是它里面的层级" },
        "directory": { "type": "boolean", "description": "是否是文件夹（文件夹没有内容）" },
        "content": { "type": "string", "description": "文件的内容，Base64 编码；文件夹为空" }
      },
      "required": ["path", "directory", "content"]
    },
    "ImportOutcome": {
      "type": "object",
      "description": "导入一个文件或文件夹的结果。",
      "properties": {
        "name": { "type": "string", "description": "拖入的文件或文件夹的名称" },
        "ok": { "type": "boolean", "description": "是否成功" },
        "message": { "type": "string", "description": "失败的原因，面向用户；成功时为空" }
      },
      "required": ["name", "ok", "message"]
    }
  },
  "requests": {
    "setRoot": {
      "description": "设置目录并开始监视与扫描（目录里的镜像文件与文件夹有变化时核心自己重新扫描）；path 为 null 表示取消。路径只来自用户在系统窗口里选的文件夹，界面不能传。",
      "mainOnly": true,
      "params": {
        "type": "object",
        "properties": { "path": { "type": ["string", "null"], "description": "目录的路径；null 表示取消" } },
        "required": ["path"]
      },
      "result": {
        "type": "object",
        "properties": { "available": { "type": "boolean", "description": "目录是否存在、能否读取" } },
        "required": ["available"]
      },
      "errors": ["filemanager.invalidPath"]
    },
    "tree": {
      "description": "目录里一个文件夹的直接内容：全部子文件夹（空文件夹也列出）与全部文件（不分扩展名，含隐藏文件；支持的种类是软盘镜像 img、ima、vfd、dsk、flp、do、po、nib、woz，nes 卡带，png 图片，以及录音机支持的音频 m4a、mp3、wav、aac、flac、ogg、opus、mp4、mka，其他文件标为 unsupported），文件夹在前、按名称排序；只读这一层的文件名、大小与种类，不读文件内容，不递归。",
      "params": {
        "type": "object",
        "properties": { "directory": { "type": "string", "maxLength": 1024, "description": "目录里的相对文件夹路径；空串是目录本身" } },
        "required": ["directory"]
      },
      "result": {
        "type": "object",
        "properties": {
          "root": { "type": ["string", "null"], "description": "目录的路径，用来显示；没有设置时为 null" },
          "available": { "type": "boolean", "description": "目录是否存在、能否读取" },
          "nodes": { "type": "array", "items": { "$ref": "#/types/ImageNode" }, "description": "这个文件夹里的节点，文件夹在前、名称排序；path 是节点相对目录的完整路径" }
        },
        "required": ["root", "available", "nodes"]
      },
      "errors": ["filemanager.invalidPath"]
    },
    "list": {
      "description": "列出镜像里一个文件夹的内容（directory 为空是根目录），顺序与磁盘上的目录一致；镜像插在软驱里时读软驱里的盘片，否则读文件。",
      "params": {
        "type": "object",
        "properties": {
          "image": { "type": "string", "minLength": 1, "maxLength": 1024, "description": "镜像的相对路径" },
          "directory": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 255 }, "maxItems": 64, "description": "镜像里的文件夹路径，逐级的名称；空数组是根目录" }
        },
        "required": ["image", "directory"]
      },
      "result": {
        "type": "object",
        "properties": {
          "fileSystem": { "$ref": "#/types/FileSystemInfo" },
          "capacity": { "type": "integer", "minimum": 0, "description": "文件系统能存放文件内容的全部空间（字节）：FAT 按簇、DOS 3.3 按扇区、ProDOS 按块算" },
          "freeSpace": { "type": "integer", "minimum": 0, "description": "现在还空着的空间（字节）" },
          "entries": { "type": "array", "items": { "$ref": "#/types/EntryInfo" }, "description": "目录里的条目" },
          "drive": { "type": ["integer", "null"], "description": "镜像插在哪个软驱里（编号从 0 起）；没有插入时为 null" },
          "readOnlyReason": { "type": ["string", "null"], "description": "不能修改的原因（位流格式、软驱里的盘片写保护）；可以修改时为 null" },
          "undoDepth": { "type": "integer", "minimum": 0, "description": "这个镜像里可以撤销的操作数" }
        },
        "required": ["fileSystem", "capacity", "freeSpace", "entries", "drive", "readOnlyReason", "undoDepth"]
      },
      "errors": ["filemanager.noRoot", "filemanager.invalidPath", "filemanager.imageNotFound", "filemanager.imageUnreadable", "filemanager.unknownFormat", "filemanager.entryNotFound", "filemanager.corrupt"]
    },
    "rename": {
      "description": "重命名镜像里的条目（不改所在文件夹）；立即生效：镜像插在软驱里时改软驱里的盘片并随后写回文件，否则直接改文件。名称规则按文件系统：FAT 是 8.3，DOS 3.3 最长 30 个字符，ProDOS 最长 15 个字符。",
      "params": {
        "type": "object",
        "properties": {
          "image": { "type": "string", "minLength": 1, "maxLength": 1024, "description": "镜像的相对路径" },
          "entry": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 255 }, "minItems": 1, "maxItems": 64, "description": "条目的路径：从根目录开始逐级的名称" },
          "name": { "type": "string", "minLength": 1, "maxLength": 255, "description": "新名称" }
        },
        "required": ["image", "entry", "name"]
      },
      "result": { "type": "object", "properties": {}, "required": [] },
      "errors": ["filemanager.noRoot", "filemanager.invalidPath", "filemanager.imageNotFound", "filemanager.imageUnreadable", "filemanager.unknownFormat", "filemanager.readOnly", "filemanager.entryNotFound", "filemanager.exists", "filemanager.invalidName", "filemanager.corrupt", "filemanager.saveFailed"]
    },
    "remove": {
      "description": "删除镜像里的条目，文件夹连同里面的全部内容；立即生效，不确认，可以用 filemanager.undo 撤销。",
      "params": {
        "type": "object",
        "properties": {
          "image": { "type": "string", "minLength": 1, "maxLength": 1024, "description": "镜像的相对路径" },
          "entries": { "type": "array", "items": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 255 }, "minItems": 1, "maxItems": 64 }, "minItems": 1, "maxItems": 1000, "description": "要删除的条目，每项是从根目录开始逐级的名称" }
        },
        "required": ["image", "entries"]
      },
      "result": { "type": "object", "properties": {}, "required": [] },
      "errors": ["filemanager.noRoot", "filemanager.invalidPath", "filemanager.imageNotFound", "filemanager.imageUnreadable", "filemanager.unknownFormat", "filemanager.readOnly", "filemanager.entryNotFound", "filemanager.corrupt", "filemanager.saveFailed"]
    },
    "move": {
      "description": "把条目移到镜像里的另一个文件夹，名称不变；没有子目录的文件系统（DOS 3.3）返回 filemanager.unsupported。",
      "params": {
        "type": "object",
        "properties": {
          "image": { "type": "string", "minLength": 1, "maxLength": 1024, "description": "镜像的相对路径" },
          "entries": { "type": "array", "items": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 255 }, "minItems": 1, "maxItems": 64 }, "minItems": 1, "maxItems": 1000, "description": "要移动的条目" },
          "target": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 255 }, "maxItems": 64, "description": "目标文件夹的路径；空数组是根目录" }
        },
        "required": ["image", "entries", "target"]
      },
      "result": { "type": "object", "properties": {}, "required": [] },
      "errors": ["filemanager.noRoot", "filemanager.invalidPath", "filemanager.imageNotFound", "filemanager.imageUnreadable", "filemanager.unknownFormat", "filemanager.readOnly", "filemanager.unsupported", "filemanager.entryNotFound", "filemanager.exists", "filemanager.moveIntoSelf", "filemanager.noSpace", "filemanager.corrupt", "filemanager.saveFailed"]
    },
    "copy": {
      "description": "把条目（文件夹连同里面的内容）复制到另一个文件夹，可以在同一个镜像里，也可以复制到另一个镜像（用来在两个镜像之间搬文件）；名称不变，目标里已有同名条目时拒绝。",
      "params": {
        "type": "object",
        "properties": {
          "image": { "type": "string", "minLength": 1, "maxLength": 1024, "description": "来源镜像的相对路径" },
          "entries": { "type": "array", "items": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 255 }, "minItems": 1, "maxItems": 64 }, "minItems": 1, "maxItems": 1000, "description": "要复制的条目" },
          "targetImage": { "type": "string", "minLength": 1, "maxLength": 1024, "description": "目标镜像的相对路径" },
          "target": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 255 }, "maxItems": 64, "description": "目标文件夹的路径；空数组是根目录" }
        },
        "required": ["image", "entries", "targetImage", "target"]
      },
      "result": { "type": "object", "properties": {}, "required": [] },
      "errors": ["filemanager.noRoot", "filemanager.invalidPath", "filemanager.imageNotFound", "filemanager.imageUnreadable", "filemanager.unknownFormat", "filemanager.readOnly", "filemanager.unsupported", "filemanager.entryNotFound", "filemanager.exists", "filemanager.invalidName", "filemanager.noSpace", "filemanager.corrupt", "filemanager.saveFailed"]
    },
    "makeDirectory": {
      "description": "在镜像里新建文件夹；没有子目录的文件系统（DOS 3.3）返回 filemanager.unsupported。",
      "params": {
        "type": "object",
        "properties": {
          "image": { "type": "string", "minLength": 1, "maxLength": 1024, "description": "镜像的相对路径" },
          "directory": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 255 }, "maxItems": 64, "description": "在哪个文件夹里新建；空数组是根目录" },
          "name": { "type": "string", "minLength": 1, "maxLength": 255, "description": "文件夹名称" }
        },
        "required": ["image", "directory", "name"]
      },
      "result": { "type": "object", "properties": {}, "required": [] },
      "errors": ["filemanager.noRoot", "filemanager.invalidPath", "filemanager.imageNotFound", "filemanager.imageUnreadable", "filemanager.unknownFormat", "filemanager.readOnly", "filemanager.unsupported", "filemanager.entryNotFound", "filemanager.exists", "filemanager.invalidName", "filemanager.noSpace", "filemanager.corrupt", "filemanager.saveFailed"]
    },
    "undo": {
      "description": "撤销这个镜像里最近一次管理操作（每个镜像各有一份撤销记录，只在内存里，核心重启后清空）；镜像里被撤销的位置已被别的程序或机器改动过时拒绝，不覆盖那些改动。",
      "params": {
        "type": "object",
        "properties": { "image": { "type": "string", "minLength": 1, "maxLength": 1024, "description": "镜像的相对路径" } },
        "required": ["image"]
      },
      "result": {
        "type": "object",
        "properties": { "description": { "type": "string", "description": "撤销的是哪一步操作，如“删除 HELLO.BAS”" } },
        "required": ["description"]
      },
      "errors": ["filemanager.noRoot", "filemanager.invalidPath", "filemanager.imageNotFound", "filemanager.imageUnreadable", "filemanager.readOnly", "filemanager.nothingToUndo", "filemanager.undoBlocked", "filemanager.saveFailed"]
    },
    "readEntries": {
      "description": "读出条目的内容用来导出：文件给出原样内容与建议的 Windows 文件名（DOS 3.3 与 ProDOS 带类型对应的扩展名），文件夹带着里面的全部内容；总量超过 64 MB 时返回 filemanager.noSpace。",
      "params": {
        "type": "object",
        "properties": {
          "image": { "type": "string", "minLength": 1, "maxLength": 1024, "description": "镜像的相对路径" },
          "entries": { "type": "array", "items": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 255 }, "minItems": 1, "maxItems": 64 }, "minItems": 1, "maxItems": 1000, "description": "要导出的条目" }
        },
        "required": ["image", "entries"]
      },
      "result": {
        "type": "object",
        "properties": { "items": { "type": "array", "items": { "$ref": "#/types/ExportItem" }, "description": "导出的内容，文件夹在它里面的文件之前" } },
        "required": ["items"]
      },
      "errors": ["filemanager.noRoot", "filemanager.invalidPath", "filemanager.imageNotFound", "filemanager.imageUnreadable", "filemanager.unknownFormat", "filemanager.entryNotFound", "filemanager.noSpace", "filemanager.corrupt"]
    },
    "importFiles": {
      "description": "把 Windows 上的文件与文件夹导入镜像的一个文件夹（文件夹连同里面的文件）；每个拖入的文件或文件夹各给一个结果，某一个失败不影响其他的。路径只来自拖入窗口的文件，界面不能传。",
      "mainOnly": true,
      "params": {
        "type": "object",
        "properties": {
          "image": { "type": "string", "minLength": 1, "maxLength": 1024, "description": "镜像的相对路径" },
          "directory": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 255 }, "maxItems": 64, "description": "导入到哪个文件夹；空数组是根目录" },
          "paths": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "maxItems": 1000, "description": "要导入的文件与文件夹的路径" }
        },
        "required": ["image", "directory", "paths"]
      },
      "result": {
        "type": "object",
        "properties": { "outcomes": { "type": "array", "items": { "$ref": "#/types/ImportOutcome" }, "description": "每个拖入项的结果，顺序同 paths" } },
        "required": ["outcomes"]
      },
      "errors": ["filemanager.noRoot", "filemanager.invalidPath", "filemanager.imageNotFound", "filemanager.imageUnreadable", "filemanager.unknownFormat", "filemanager.readOnly", "filemanager.entryNotFound", "filemanager.saveFailed"]
    },
    "createImage": {
      "description": "在目录的一个文件夹里新建空白镜像，文件名自动取不重名的“新建磁盘镜像.扩展名”。",
      "params": {
        "type": "object",
        "properties": {
          "directory": { "type": "string", "maxLength": 1024, "description": "目录里的相对文件夹路径；空串是目录本身" },
          "kind": { "type": "string", "minLength": 1, "maxLength": 32, "description": "空白镜像的种类，见 filemanager.blankKinds" }
        },
        "required": ["directory", "kind"]
      },
      "result": {
        "type": "object",
        "properties": { "path": { "type": "string", "description": "新建的镜像的相对路径" } },
        "required": ["path"]
      },
      "errors": ["filemanager.noRoot", "filemanager.invalidPath", "filemanager.unsupported", "filemanager.saveFailed"]
    },
    "renameItem": {
      "description": "重命名目录里的文件或文件夹（不换所在文件夹）；镜像文件的新名称必须保留支持的扩展名；镜像正插在软驱里（文件夹里有镜像插在软驱里）时返回 filemanager.inUse。",
      "params": {
        "type": "object",
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 1024, "description": "文件或文件夹的相对路径" },
          "name": { "type": "string", "minLength": 1, "maxLength": 255, "description": "新名称" }
        },
        "required": ["path", "name"]
      },
      "result": {
        "type": "object",
        "properties": { "path": { "type": "string", "description": "重命名之后的相对路径" } },
        "required": ["path"]
      },
      "errors": ["filemanager.noRoot", "filemanager.invalidPath", "filemanager.entryNotFound", "filemanager.invalidName", "filemanager.exists", "filemanager.inUse", "filemanager.saveFailed"]
    },
    "removeItems": {
      "description": "把目录里的文件或文件夹（连同里面的内容）移进系统回收站，立即生效，不确认；镜像正插在软驱里（文件夹里有镜像插在软驱里）时返回 filemanager.inUse。",
      "params": {
        "type": "object",
        "properties": {
          "paths": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 1024 }, "minItems": 1, "maxItems": 1000, "description": "要删除的文件或文件夹的相对路径" }
        },
        "required": ["paths"]
      },
      "result": { "type": "object", "properties": {}, "required": [] },
      "errors": ["filemanager.noRoot", "filemanager.invalidPath", "filemanager.entryNotFound", "filemanager.inUse", "filemanager.saveFailed"]
    },
    "moveItems": {
      "description": "把目录里的文件或文件夹移进另一个文件夹，名称不变，目标里已有同名项时拒绝；镜像正插在软驱里（文件夹里有镜像插在软驱里）时返回 filemanager.inUse。",
      "params": {
        "type": "object",
        "properties": {
          "paths": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 1024 }, "minItems": 1, "maxItems": 1000, "description": "要移动的文件或文件夹的相对路径" },
          "target": { "type": "string", "maxLength": 1024, "description": "目标文件夹的相对路径；空串是目录本身" }
        },
        "required": ["paths", "target"]
      },
      "result": {
        "type": "object",
        "properties": { "paths": { "type": "array", "items": { "type": "string" }, "description": "移动之后的相对路径，顺序同参数" } },
        "required": ["paths"]
      },
      "errors": ["filemanager.noRoot", "filemanager.invalidPath", "filemanager.entryNotFound", "filemanager.exists", "filemanager.moveIntoSelf", "filemanager.inUse", "filemanager.saveFailed"]
    },
    "copyItems": {
      "description": "把目录里的文件或文件夹（连同里面的内容）复制进另一个文件夹；重名时名称后加“ - 副本”“ - 副本 (2)”…。",
      "params": {
        "type": "object",
        "properties": {
          "paths": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 1024 }, "minItems": 1, "maxItems": 1000, "description": "要复制的文件或文件夹的相对路径" },
          "target": { "type": "string", "maxLength": 1024, "description": "目标文件夹的相对路径；空串是目录本身" }
        },
        "required": ["paths", "target"]
      },
      "result": {
        "type": "object",
        "properties": { "paths": { "type": "array", "items": { "type": "string" }, "description": "复制出来的相对路径，顺序同参数" } },
        "required": ["paths"]
      },
      "errors": ["filemanager.noRoot", "filemanager.invalidPath", "filemanager.entryNotFound", "filemanager.moveIntoSelf", "filemanager.saveFailed"]
    },
    "makeFolder": {
      "description": "在目录里的文件夹中新建子文件夹，名称取 name，重名时依次加“ (2)”“ (3)”…。",
      "params": {
        "type": "object",
        "properties": {
          "directory": { "type": "string", "maxLength": 1024, "description": "在哪个文件夹里新建（相对路径）；空串是目录本身" },
          "name": { "type": "string", "minLength": 1, "maxLength": 255, "description": "文件夹的基本名称" }
        },
        "required": ["directory", "name"]
      },
      "result": {
        "type": "object",
        "properties": { "path": { "type": "string", "description": "新文件夹的相对路径" } },
        "required": ["path"]
      },
      "errors": ["filemanager.noRoot", "filemanager.invalidPath", "filemanager.invalidName", "filemanager.saveFailed"]
    },
    "blankKinds": {
      "description": "能新建的空白镜像种类。",
      "params": { "type": "object", "properties": {}, "required": [] },
      "result": {
        "type": "object",
        "properties": { "kinds": { "type": "array", "items": { "$ref": "#/types/BlankKind" }, "description": "种类，按界面显示的顺序" } },
        "required": ["kinds"]
      },
      "errors": []
    },
    "imagePath": {
      "description": "镜像文件在磁盘上的完整路径，给外壳用：载入软驱、在文件管理器里显示；界面不能调用。",
      "mainOnly": true,
      "params": {
        "type": "object",
        "properties": { "image": { "type": "string", "minLength": 1, "maxLength": 1024, "description": "镜像的相对路径" } },
        "required": ["image"]
      },
      "result": {
        "type": "object",
        "properties": { "path": { "type": "string", "description": "完整路径" } },
        "required": ["path"]
      },
      "errors": ["filemanager.noRoot", "filemanager.invalidPath", "filemanager.imageNotFound"]
    }
  },
  "mainRequests": {
    "openRoot": {
      "description": "把外壳保存的目录交给核心并开始监视；没有保存过目录时什么都不做。界面在核心就绪后调用一次。",
      "params": { "type": "object", "properties": {}, "required": [] },
      "result": {
        "type": "object",
        "properties": { "root": { "type": ["string", "null"], "description": "当前的目录；没有时为 null" } },
        "required": ["root"]
      },
      "errors": ["filemanager.invalidPath"]
    },
    "pickRoot": {
      "description": "弹出系统的选择文件夹窗口，把用户选定的文件夹设为目录（交给 filemanager.setRoot 并保存到外壳设置）；用户取消时 canceled 为 true，不是错误。",
      "params": { "type": "object", "properties": {}, "required": [] },
      "result": {
        "type": "object",
        "properties": {
          "canceled": { "type": "boolean", "description": "用户是否取消了选择" },
          "root": { "type": ["string", "null"], "description": "设置后的目录；取消时没有这一项" }
        },
        "required": ["canceled"]
      },
      "errors": ["filemanager.invalidPath"]
    },
    "importDropped": {
      "description": "把拖入管理窗口的文件与文件夹导入镜像（交给 filemanager.importFiles）；droppedIds 是拖放时外壳登记的编号，路径只在外壳里。",
      "params": {
        "type": "object",
        "properties": {
          "image": { "type": "string", "minLength": 1, "maxLength": 1024, "description": "镜像的相对路径" },
          "directory": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 255 }, "maxItems": 64, "description": "导入到哪个文件夹；空数组是根目录" },
          "droppedIds": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 1, "maxItems": 1000, "description": "拖入的文件与文件夹的编号" }
        },
        "required": ["image", "directory", "droppedIds"]
      },
      "result": {
        "type": "object",
        "properties": { "outcomes": { "type": "array", "items": { "$ref": "#/types/ImportOutcome" }, "description": "每个拖入项的结果" } },
        "required": ["outcomes"]
      },
      "errors": ["filemanager.noRoot", "filemanager.invalidPath", "filemanager.imageNotFound", "filemanager.imageUnreadable", "filemanager.unknownFormat", "filemanager.readOnly", "filemanager.entryNotFound", "filemanager.saveFailed", "filemanager.droppedNotFound"]
    },
    "loadImage": {
      "description": "把镜像载入软驱（交给 media.floppyInsert，它的错误原样返回）。",
      "params": {
        "type": "object",
        "properties": {
          "image": { "type": "string", "minLength": 1, "maxLength": 1024, "description": "镜像的相对路径" },
          "drive": { "type": "integer", "minimum": 0, "maximum": 3, "description": "软驱编号" }
        },
        "required": ["image", "drive"]
      },
      "result": { "type": "object", "properties": {}, "required": [] },
      "errors": ["filemanager.noRoot", "filemanager.invalidPath", "filemanager.imageNotFound"]
    },
    "revealImage": {
      "description": "在系统的文件管理器里显示镜像文件（选中它）。",
      "params": {
        "type": "object",
        "properties": { "image": { "type": "string", "minLength": 1, "maxLength": 1024, "description": "镜像的相对路径" } },
        "required": ["image"]
      },
      "result": { "type": "object", "properties": {}, "required": [] },
      "errors": ["filemanager.noRoot", "filemanager.invalidPath", "filemanager.imageNotFound", "filemanager.revealUnavailable"]
    },
    "runCartridge": {
      "description": "把目录里的 nes 卡带加载到模拟器并开机进入游戏（与“打开卡带”一样记入最近打开的清单，交给 cartridges.load，它的错误原样返回）。",
      "params": {
        "type": "object",
        "properties": { "file": { "type": "string", "minLength": 1, "maxLength": 1024, "description": "卡带文件的相对路径" } },
        "required": ["file"]
      },
      "result": { "type": "object", "properties": {}, "required": [] },
      "errors": ["filemanager.noRoot", "filemanager.invalidPath", "filemanager.imageNotFound"]
    },
    "loadTape": {
      "description": "把目录里的音频文件作为磁带载入录音机（交给 media.tapeLoad，它的错误原样返回）。",
      "params": {
        "type": "object",
        "properties": { "file": { "type": "string", "minLength": 1, "maxLength": 1024, "description": "音频文件的相对路径" } },
        "required": ["file"]
      },
      "result": { "type": "object", "properties": {}, "required": [] },
      "errors": ["filemanager.noRoot", "filemanager.invalidPath", "filemanager.imageNotFound"]
    },
    "openFile": {
      "description": "用系统默认的程序打开目录里的文件（预览 png 图片）。",
      "params": {
        "type": "object",
        "properties": { "file": { "type": "string", "minLength": 1, "maxLength": 1024, "description": "文件的相对路径" } },
        "required": ["file"]
      },
      "result": { "type": "object", "properties": {}, "required": [] },
      "errors": ["filemanager.noRoot", "filemanager.invalidPath", "filemanager.imageNotFound", "filemanager.openUnavailable"]
    }
  },
  "events": {
    "treeChanged": {
      "description": "目录的树变了：文件夹或文件被创建、删除、改名；用 filemanager.tree 重新读取已经展开的文件夹。",
      "data": { "type": "object", "properties": {}, "required": [] }
    },
    "imageChanged": {
      "description": "一个镜像的内容变了：管理操作、机器写盘、别的程序改了镜像文件；正在查看它的界面要重新读取。",
      "data": {
        "type": "object",
        "properties": { "image": { "type": "string", "description": "镜像的相对路径" } },
        "required": ["image"]
      }
    }
  }
}
