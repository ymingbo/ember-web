{
  "id": "waixing162",
  "name": "Waixing 162",
  "version": "1.0.0",
  "apiVersion": 1,
  "publisher": "Ember",
  "description": "Waixing FS304（mapper 162）：寄存器在 $5000-$5FFF，地址位 8-9 选四个寄存器之一；PRG 32K 的 bank 由寄存器 0、1、2 按寄存器 3 的位 0 与位 2 指定的组合方式拼成；CHR 固定 8K。",
  "host": ["fc"],
  "match": [
    { "mapper": 162 }
  ],
  "storage": [
    { "id": "prg", "kind": "rom", "from": "file.prg" },
    { "id": "chr", "kind": "rom", "from": "file.chr", "fallback": { "kind": "ram", "size": { "header": "chrRam", "default": 8192 } } },
    { "id": "prg-ram", "kind": "ram", "size": { "header": "prgAny", "default": 8192 } }
  ],
  "windows": [
    { "id": "prg-8000-32k", "bus": "cpu", "range": "$8000-$FFFF", "storage": "prg", "size": 32768, "initial": 0, "access": "r" },
    { "id": "chr-0000", "bus": "ppu", "range": "$0000-$1FFF", "storage": "chr", "size": 8192, "initial": 0, "access": "rw" },
    { "id": "prg-ram", "bus": "cpu", "range": "$6000-$7FFF", "storage": "prg-ram", "size": 8192, "initial": 0, "access": "rw" }
  ],
  "registers": [
    { "bus": "cpu", "range": "$5000-$5FFF", "write": true }
  ],
  "state": [
    { "name": "reg0", "bits": 8, "description": "寄存器 0" },
    { "name": "reg1", "bits": 8, "description": "寄存器 1" },
    { "name": "reg2", "bits": 8, "description": "寄存器 2" },
    { "name": "reg3", "bits": 8, "description": "寄存器 3" }
  ],
  "nametable": "header"
}
