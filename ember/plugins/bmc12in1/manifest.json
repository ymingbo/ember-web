{
  "id": "bmc12in1",
  "name": "BMC-12in1",
  "version": "1.0.0",
  "apiVersion": 1,
  "publisher": "Ember",
  "description": "12-in-1 合集卡（mapper 331）：$A000、$C000 写入两个 4K CHR 寄存器，$E000 写入模式；模式低 2 位选外层 bank，位 3 为 1 时 PRG 按 32K 一对映射，为 0 时 $8000 窗口取内层、$C000 窗口固定为外层的第 7 个；位 2 选名称表镜像（1 为水平）。",
  "host": ["fc"],
  "match": [
    { "mapper": 331 }
  ],
  "storage": [
    { "id": "prg", "kind": "rom", "from": "file.prg" },
    { "id": "chr", "kind": "rom", "from": "file.chr", "fallback": { "kind": "ram", "size": { "header": "chrRam", "default": 8192 } } },
    { "id": "prg-ram", "kind": "ram", "size": { "header": "prgAny", "default": 8192 } }
  ],
  "windows": [
    { "id": "prg-8000-16k", "bus": "cpu", "range": "$8000-$BFFF", "storage": "prg", "size": 16384, "initial": 0, "access": "r" },
    { "id": "prg-c000-16k", "bus": "cpu", "range": "$C000-$FFFF", "storage": "prg", "size": 16384, "initial": 7, "access": "r" },
    { "id": "chr-0000", "bus": "ppu", "range": "$0000-$0FFF", "storage": "chr", "size": 4096, "initial": 0, "access": "rw" },
    { "id": "chr-1000", "bus": "ppu", "range": "$1000-$1FFF", "storage": "chr", "size": 4096, "initial": 0, "access": "rw" },
    { "id": "prg-ram", "bus": "cpu", "range": "$6000-$7FFF", "storage": "prg-ram", "size": 8192, "initial": 0, "access": "rw" }
  ],
  "registers": [
    { "bus": "cpu", "range": "$8000-$FFFF", "write": true }
  ],
  "state": [
    { "name": "reg0", "bits": 8, "description": "$A000 写入的寄存器" },
    { "name": "reg1", "bits": 8, "description": "$C000 写入的寄存器" },
    { "name": "mode", "bits": 4, "description": "$E000 写入的模式" }
  ],
  "nametable": "header"
}
