{
  "id": "kaiser202",
  "name": "Kaiser KS-202",
  "version": "1.0.0",
  "apiVersion": 1,
  "publisher": "Ember",
  "description": "Kaiser KS-202（mapper 56、142）：$E000 选 PRG 寄存器，$F000 写其低 4 位（寄存器 4 的位 2 选 $6000 为 ROM 或 RAM），mapper 56 另按 $F000-$FFFF 的地址位选位 4、镜像与 CHR 页；$8000-$B000 写重载值，$C000 位 1 允许计数，每周期加 1，到 $FFFF 时重载并发出一次 IRQ。",
  "host": ["fc"],
  "match": [
    { "mapper": 56 },
    { "mapper": 142 }
  ],
  "storage": [
    { "id": "prg", "kind": "rom", "from": "file.prg" },
    { "id": "chr", "kind": "rom", "from": "file.chr", "fallback": { "kind": "ram", "size": { "header": "chrRam", "default": 8192 } } },
    { "id": "prg-ram", "kind": "ram", "size": { "header": "prgAny", "default": 8192 } }
  ],
  "windows": [
    { "id": "prg-8000", "bus": "cpu", "range": "$8000-$9FFF", "storage": "prg", "size": 8192, "initial": 0, "access": "r" },
    { "id": "prg-a000", "bus": "cpu", "range": "$A000-$BFFF", "storage": "prg", "size": 8192, "initial": 0, "access": "r" },
    { "id": "prg-c000", "bus": "cpu", "range": "$C000-$DFFF", "storage": "prg", "size": 8192, "initial": 0, "access": "r" },
    { "id": "prg-e000", "bus": "cpu", "range": "$E000-$FFFF", "storage": "prg", "size": 8192, "initial": -1, "access": "r" },
    { "id": "prg-6000", "bus": "cpu", "range": "$6000-$7FFF", "storage": ["prg-ram", "prg"], "size": 8192, "initial": 0, "access": "rw" },
    { "id": "chr-0000", "bus": "ppu", "range": "$0000-$03FF", "storage": "chr", "size": 1024, "initial": 0, "access": "rw" },
    { "id": "chr-0400", "bus": "ppu", "range": "$0400-$07FF", "storage": "chr", "size": 1024, "initial": 1, "access": "rw" },
    { "id": "chr-0800", "bus": "ppu", "range": "$0800-$0BFF", "storage": "chr", "size": 1024, "initial": 2, "access": "rw" },
    { "id": "chr-0c00", "bus": "ppu", "range": "$0C00-$0FFF", "storage": "chr", "size": 1024, "initial": 3, "access": "rw" },
    { "id": "chr-1000", "bus": "ppu", "range": "$1000-$13FF", "storage": "chr", "size": 1024, "initial": 4, "access": "rw" },
    { "id": "chr-1400", "bus": "ppu", "range": "$1400-$17FF", "storage": "chr", "size": 1024, "initial": 5, "access": "rw" },
    { "id": "chr-1800", "bus": "ppu", "range": "$1800-$1BFF", "storage": "chr", "size": 1024, "initial": 6, "access": "rw" },
    { "id": "chr-1c00", "bus": "ppu", "range": "$1C00-$1FFF", "storage": "chr", "size": 1024, "initial": 7, "access": "rw" }
  ],
  "registers": [
    { "bus": "cpu", "range": "$8000-$FFFF", "write": true }
  ],
  "nametable": "header"
}
