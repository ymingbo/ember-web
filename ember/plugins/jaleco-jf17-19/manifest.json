{
  "id": "jaleco-jf17-19",
  "name": "Jaleco JF-17/JF-19",
  "version": "1.0.0",
  "apiVersion": 1,
  "publisher": "Ember",
  "description": "Jaleco JF-17（mapper 72）与 JF-19（mapper 92）：写入值的位 7 由 0 变 1 时更新 PRG bank（JF-17 切 $8000 起的 16K、取低 3 位，JF-19 切 $C000 起的 16K、取低 4 位，另一半固定），位 6 由 0 变 1 时更新 8K 的 CHR bank（低 4 位）；有总线冲突；声音位不支持。",
  "host": ["fc"],
  "busConflict": true,
  "match": [
    { "mapper": 72 },
    { "mapper": 92 }
  ],
  "storage": [
    { "id": "prg", "kind": "rom", "from": "file.prg" },
    { "id": "chr", "kind": "rom", "from": "file.chr", "fallback": { "kind": "ram", "size": { "header": "chrRam", "default": 8192 } } },
    { "id": "prg-ram", "kind": "ram", "size": { "header": "prgAny", "default": 8192 } }
  ],
  "windows": [
    { "id": "prg-8000-16k", "bus": "cpu", "range": "$8000-$BFFF", "storage": "prg", "size": 16384, "initial": 0, "access": "r" },
    { "id": "prg-c000-16k", "bus": "cpu", "range": "$C000-$FFFF", "storage": "prg", "size": 16384, "initial": "last", "access": "r" },
    { "id": "chr-0000", "bus": "ppu", "range": "$0000-$1FFF", "storage": "chr", "size": 8192, "initial": 0, "access": "rw" },
    { "id": "prg-ram", "bus": "cpu", "range": "$6000-$7FFF", "storage": "prg-ram", "size": 8192, "initial": 0, "access": "rw" }
  ],
  "registers": [
    { "bus": "cpu", "range": "$8000-$FFFF", "write": true }
  ],
  "state": [
    { "name": "prgFlag", "bits": 1, "description": "上一次写入的位 7" },
    { "name": "chrFlag", "bits": 1, "description": "上一次写入的位 6" }
  ],
  "nametable": "header"
}
