{
  "id": "mapper-43",
  "name": "Mapper43",
  "version": "1.0.0",
  "apiVersion": 1,
  "publisher": "Ember",
  "description": "盗版卡（mapper 43）：$4022 写入的低 3 位按表选 $C000 的 8K 页，$4120 的位 0 对调 $6000 与 $E000 的页，$5000-$5FFF 固定为 PRG 偏移 $10000 处的 4K；$4122 或 $8122 写入位 0 为 1 时 4096 个 CPU 周期后发出一次 IRQ，为 0 时关闭。",
  "host": ["fc"],
  "match": [
    { "mapper": 43 }
  ],
  "storage": [
    { "id": "prg", "kind": "rom", "from": "file.prg" },
    { "id": "chr", "kind": "rom", "from": "file.chr", "fallback": { "kind": "ram", "size": { "header": "chrRam", "default": 8192 } } },
    { "id": "prg-ram", "kind": "ram", "size": { "header": "prgAny", "default": 8192 } }
  ],
  "windows": [
    { "id": "prg-8000", "bus": "cpu", "range": "$8000-$9FFF", "storage": "prg", "size": 8192, "initial": 1, "access": "r" },
    { "id": "prg-a000", "bus": "cpu", "range": "$A000-$BFFF", "storage": "prg", "size": 8192, "initial": 0, "access": "r" },
    { "id": "prg-c000", "bus": "cpu", "range": "$C000-$DFFF", "storage": "prg", "size": 8192, "initial": 2, "access": "r" },
    { "id": "prg-e000", "bus": "cpu", "range": "$E000-$FFFF", "storage": "prg", "size": 8192, "initial": 9, "access": "r" },
    { "id": "prg-5000", "bus": "cpu", "range": "$5000-$5FFF", "storage": "prg", "size": 4096, "initial": 16, "access": "r" },
    { "id": "prg-6000", "bus": "cpu", "range": "$6000-$7FFF", "storage": "prg", "size": 8192, "initial": 2, "access": "r" },
    { "id": "chr-0000", "bus": "ppu", "range": "$0000-$1FFF", "storage": "chr", "size": 8192, "initial": 0, "access": "rw" }
  ],
  "registers": [
    { "bus": "cpu", "range": "$4020-$FFFF", "write": true }
  ],
  "nametable": "header"
}
