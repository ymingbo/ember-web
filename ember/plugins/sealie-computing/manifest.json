{
  "id": "sealie-computing",
  "name": "Sealie Computing",
  "version": "1.0.0",
  "apiVersion": 1,
  "publisher": "Ember",
  "description": "Sealie Computing 的自制 mapper（mapper 29）：$8000 起 16K 可切换，$C000 起 16K 固定为最后一个 bank；$8000-$FFFF 写入值的位 2-4 选 PRG bank，位 0-1 选 8K 的 CHR bank（默认 32K CHR RAM）；$6000-$7FFF 是 8K 工作 RAM。",
  "host": ["fc"],
  "match": [
    { "mapper": 29 }
  ],
  "storage": [
    { "id": "prg", "kind": "rom", "from": "file.prg" },
    { "id": "chr", "kind": "rom", "from": "file.chr", "fallback": { "kind": "ram", "size": { "header": "chrRam", "default": 32768 } } },
    { "id": "prg-ram", "kind": "ram", "size": { "header": "prgAny", "default": 8192 } }
  ],
  "windows": [
    { "id": "prg-8000-16k", "bus": "cpu", "range": "$8000-$BFFF", "storage": "prg", "size": 16384, "initial": 0, "access": "r" },
    { "id": "prg-c000-16k", "bus": "cpu", "range": "$C000-$FFFF", "storage": "prg", "size": 16384, "initial": "last", "access": "r" },
    { "id": "chr-0000", "bus": "ppu", "range": "$0000-$1FFF", "storage": "chr", "size": 8192, "initial": 0, "access": "rw" },
    { "id": "prg-ram", "bus": "cpu", "range": "$6000-$7FFF", "storage": "prg-ram", "size": 8192, "initial": 0, "access": "rw" }
  ],
  "registers": [
    { "bus": "cpu", "range": "$8000-$FFFF", "write": { "state": "register", "bank": [{ "window": "chr-0000", "shift": 0, "mask": 3 },{ "window": "prg-8000-16k", "shift": 2, "mask": 7 }] } }
  ],
  "state": [
    { "name": "register", "bits": 8, "description": "最后写入的值（位 0-1 为 CHR bank，位 2-4 为 PRG bank）" }
  ],
  "nametable": "header"
}
