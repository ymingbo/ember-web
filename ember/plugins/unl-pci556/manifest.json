{
  "id": "unl-pci556",
  "name": "UNL-PCI556",
  "version": "1.0.0",
  "apiVersion": 1,
  "publisher": "Ember",
  "description": "PCI556（mapper 38）：寄存器在 $7000-$7FFF，写入值的低 2 位选 32K 的 PRG bank，位 2-3 选 8K 的 CHR bank。",
  "host": ["fc"],
  "match": [
    { "mapper": 38 }
  ],
  "storage": [
    { "id": "prg", "kind": "rom", "from": "file.prg" },
    { "id": "chr", "kind": "rom", "from": "file.chr", "fallback": { "kind": "ram", "size": { "header": "chrRam", "default": 8192 } } },
    { "id": "prg-ram", "kind": "ram", "size": { "header": "prgAny", "default": 8192 } }
  ],
  "windows": [
    { "id": "prg-8000-32k", "bus": "cpu", "range": "$8000-$FFFF", "storage": "prg", "size": 32768, "initial": 0, "access": "r" },
    { "id": "chr-0000", "bus": "ppu", "range": "$0000-$1FFF", "storage": "chr", "size": 8192, "initial": 0, "access": "rw" },
    { "id": "prg-ram", "bus": "cpu", "range": "$6000-$7FFF", "storage": "prg-ram", "size": 8192, "initial": 0, "access": "rw" }
  ],
  "registers": [
    { "bus": "cpu", "range": "$7000-$7FFF", "write": { "state": "register", "bank": [{ "window": "prg-8000-32k", "shift": 0, "mask": 3 },{ "window": "chr-0000", "shift": 2, "mask": 3 }] } }
  ],
  "state": [
    { "name": "register", "bits": 8, "description": "最后写入的值（位 0-1 为 PRG bank，位 2-3 为 CHR bank）" }
  ],
  "nametable": "header"
}
