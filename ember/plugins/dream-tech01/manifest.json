{
  "id": "dream-tech01",
  "name": "Dream Tech 01",
  "version": "1.0.0",
  "apiVersion": 1,
  "publisher": "Ember",
  "description": "Dream Tech 01（mapper 521）：$5020 写入值的低 3 位选 $8000 起 16K 的 PRG bank，$C000 起固定为第 8 个 bank。",
  "host": ["fc"],
  "match": [
    { "mapper": 521 }
  ],
  "storage": [
    { "id": "prg", "kind": "rom", "from": "file.prg" },
    { "id": "chr", "kind": "rom", "from": "file.chr", "fallback": { "kind": "ram", "size": { "header": "chrRam", "default": 8192 } } },
    { "id": "prg-ram", "kind": "ram", "size": { "header": "prgAny", "default": 8192 } }
  ],
  "windows": [
    { "id": "prg-8000-16k", "bus": "cpu", "range": "$8000-$BFFF", "storage": "prg", "size": 16384, "initial": 0, "access": "r" },
    { "id": "prg-c000-16k", "bus": "cpu", "range": "$C000-$FFFF", "storage": "prg", "size": 16384, "initial": 8, "access": "r" },
    { "id": "chr-0000", "bus": "ppu", "range": "$0000-$1FFF", "storage": "chr", "size": 8192, "initial": 0, "access": "rw" },
    { "id": "prg-ram", "bus": "cpu", "range": "$6000-$7FFF", "storage": "prg-ram", "size": 8192, "initial": 0, "access": "rw" }
  ],
  "registers": [
    { "bus": "cpu", "range": "$5020", "write": { "state": "prgBank", "bank": [{ "window": "prg-8000-16k", "shift": 0, "mask": 7 }] } }
  ],
  "state": [
    { "name": "prgBank", "bits": 3, "description": "$8000 起 16K 的 bank 号" }
  ],
  "nametable": "header"
}
