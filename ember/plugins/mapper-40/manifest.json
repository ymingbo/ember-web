{
  "id": "mapper-40",
  "name": "Mapper40",
  "version": "1.0.0",
  "apiVersion": 1,
  "publisher": "Ember",
  "description": "水浒传卡（mapper 40）：$6000-$7FFF 固定为 PRG 的第 6 个 8K 页，$8000、$A000、$E000 固定为第 4、5、7 页，$C000 由 $E000-$FFFF 的写入选择；$8000-$9FFF 写入关闭 IRQ，$A000-$BFFF 写入后 4096 个 CPU 周期发出 IRQ。",
  "host": ["fc"],
  "match": [
    { "mapper": 40 }
  ],
  "storage": [
    { "id": "prg", "kind": "rom", "from": "file.prg" },
    { "id": "chr", "kind": "rom", "from": "file.chr", "fallback": { "kind": "ram", "size": { "header": "chrRam", "default": 8192 } } },
    { "id": "prg-ram", "kind": "ram", "size": { "header": "prgAny", "default": 8192 } }
  ],
  "windows": [
    { "id": "prg-8000", "bus": "cpu", "range": "$8000-$9FFF", "storage": "prg", "size": 8192, "initial": 4, "access": "r" },
    { "id": "prg-a000", "bus": "cpu", "range": "$A000-$BFFF", "storage": "prg", "size": 8192, "initial": 5, "access": "r" },
    { "id": "prg-c000", "bus": "cpu", "range": "$C000-$DFFF", "storage": "prg", "size": 8192, "initial": 0, "access": "r" },
    { "id": "prg-e000", "bus": "cpu", "range": "$E000-$FFFF", "storage": "prg", "size": 8192, "initial": 7, "access": "r" },
    { "id": "prg-6000", "bus": "cpu", "range": "$6000-$7FFF", "storage": "prg", "size": 8192, "initial": 6, "access": "r" },
    { "id": "chr-0000", "bus": "ppu", "range": "$0000-$1FFF", "storage": "chr", "size": 8192, "initial": 0, "access": "rw" }
  ],
  "registers": [
    { "bus": "cpu", "range": "$8000-$FFFF", "write": true }
  ],
  "nametable": "header"
}
