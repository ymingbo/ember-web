{
  "id": "bmc190in1",
  "name": "BMC-190in1",
  "version": "1.0.0",
  "apiVersion": 1,
  "publisher": "Ember",
  "description": "190-in-1 合集卡（mapper 300）：$8000-$FFFF 写入值的位 2-4 同时选两个 16K 的 PRG 窗口与 8K 的 CHR bank，位 0 选名称表镜像（1 为水平）。",
  "host": ["fc"],
  "match": [
    { "mapper": 300 }
  ],
  "storage": [
    { "id": "prg", "kind": "rom", "from": "file.prg" },
    { "id": "chr", "kind": "rom", "from": "file.chr", "fallback": { "kind": "ram", "size": { "header": "chrRam", "default": 8192 } } },
    { "id": "prg-ram", "kind": "ram", "size": { "header": "prgAny", "default": 8192 } }
  ],
  "windows": [
    { "id": "prg-8000-16k", "bus": "cpu", "range": "$8000-$BFFF", "storage": "prg", "size": 16384, "initial": 0, "access": "r" },
    { "id": "prg-c000-16k", "bus": "cpu", "range": "$C000-$FFFF", "storage": "prg", "size": 16384, "initial": 0, "access": "r" },
    { "id": "chr-0000", "bus": "ppu", "range": "$0000-$1FFF", "storage": "chr", "size": 8192, "initial": 0, "access": "rw" },
    { "id": "prg-ram", "bus": "cpu", "range": "$6000-$7FFF", "storage": "prg-ram", "size": 8192, "initial": 0, "access": "rw" }
  ],
  "registers": [
    { "bus": "cpu", "range": "$8000-$FFFF", "write": true }
  ],
  "nametable": "vertical"
}
