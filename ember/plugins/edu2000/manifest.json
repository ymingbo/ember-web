{
  "id": "edu2000",
  "name": "EDU2000",
  "version": "1.0.0",
  "apiVersion": 1,
  "publisher": "Ember",
  "description": "EDU2000（mapper 329）：$8000-$FFFF 写入值的低 5 位选 32K 的 PRG bank，位 6-7 选 $6000-$7FFF 的 8K 工作 RAM 页（共 32K）。",
  "host": ["fc"],
  "match": [
    { "mapper": 329 }
  ],
  "storage": [
    { "id": "prg", "kind": "rom", "from": "file.prg" },
    { "id": "chr", "kind": "rom", "from": "file.chr", "fallback": { "kind": "ram", "size": { "header": "chrRam", "default": 8192 } } },
    { "id": "wram", "kind": "ram", "size": { "header": "prgRam", "default": 32768 } }
  ],
  "windows": [
    { "id": "prg-8000-32k", "bus": "cpu", "range": "$8000-$FFFF", "storage": "prg", "size": 32768, "initial": 0, "access": "r" },
    { "id": "chr-0000", "bus": "ppu", "range": "$0000-$1FFF", "storage": "chr", "size": 8192, "initial": 0, "access": "rw" },
    { "id": "prg-ram", "bus": "cpu", "range": "$6000-$7FFF", "storage": "wram", "size": 8192, "initial": 0, "access": "rw" }
  ],
  "registers": [
    { "bus": "cpu", "range": "$8000-$FFFF", "write": { "state": "register", "bank": [{ "window": "prg-8000-32k", "shift": 0, "mask": 31 },{ "window": "prg-ram", "shift": 6, "mask": 3 }] } }
  ],
  "state": [
    { "name": "register", "bits": 8, "description": "最后写入的值（低 5 位为 PRG bank，位 6-7 为工作 RAM 页）" }
  ],
  "nametable": "header"
}
