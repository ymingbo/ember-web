{
  "id": "irem-tam-s1",
  "name": "Irem TAM-S1",
  "version": "1.0.0",
  "apiVersion": 1,
  "publisher": "Ember",
  "description": "Irem TAM-S1（mapper 97）：$8000 起 16K 固定为最后一个 bank，$C000 起 16K 由写入值低 4 位选 bank；写入值的位 6-7 选名称表（0 单屏第一页、1 水平、2 垂直、3 单屏第二页）。",
  "host": ["fc"],
  "match": [
    { "mapper": 97 }
  ],
  "storage": [
    { "id": "prg", "kind": "rom", "from": "file.prg" },
    { "id": "chr", "kind": "rom", "from": "file.chr", "fallback": { "kind": "ram", "size": { "header": "chrRam", "default": 8192 } } },
    { "id": "prg-ram", "kind": "ram", "size": { "header": "prgAny", "default": 8192 } }
  ],
  "windows": [
    { "id": "prg-8000-16k", "bus": "cpu", "range": "$8000-$BFFF", "storage": "prg", "size": 16384, "initial": -1, "access": "r" },
    { "id": "prg-c000-16k", "bus": "cpu", "range": "$C000-$FFFF", "storage": "prg", "size": 16384, "initial": -1, "access": "r" },
    { "id": "chr-0000", "bus": "ppu", "range": "$0000-$1FFF", "storage": "chr", "size": 8192, "initial": 0, "access": "rw" },
    { "id": "prg-ram", "bus": "cpu", "range": "$6000-$7FFF", "storage": "prg-ram", "size": 8192, "initial": 0, "access": "rw" }
  ],
  "registers": [
    { "bus": "cpu", "range": "$8000-$FFFF", "write": true }
  ],
  "nametable": "header"
}
