{
  "id": "mapper-253",
  "name": "Mapper253",
  "version": "1.0.0",
  "apiVersion": 1,
  "publisher": "Ember",
  "description": "盗版卡（mapper 253）：$8010、$A010 选两个 8K 程序页（后两页固定），$B000-$E00C 按地址位分写 8 个 1K 图案页的低、高部分（低字节为 4、5 的页用 2K 的 CHR RAM，写 $C8 与 $88 切换），$9400 选镜像；$F000、$F004 写重载值，$F008 位 1 允许；每 114 个周期计一次数，8 位计数器溢出时重载并发出 IRQ。",
  "host": ["fc"],
  "match": [
    { "mapper": 253 }
  ],
  "storage": [
    { "id": "prg", "kind": "rom", "from": "file.prg" },
    { "id": "chr", "kind": "rom", "from": "file.chr", "fallback": { "kind": "ram", "size": { "header": "chrRam", "default": 8192 } } },
    { "id": "chr-ram", "kind": "ram", "size": 2048 },
    { "id": "prg-ram", "kind": "ram", "size": { "header": "prgAny", "default": 8192 } }
  ],
  "windows": [
    { "id": "prg-8000", "bus": "cpu", "range": "$8000-$9FFF", "storage": "prg", "size": 8192, "initial": 0, "access": "r" },
    { "id": "prg-a000", "bus": "cpu", "range": "$A000-$BFFF", "storage": "prg", "size": 8192, "initial": 0, "access": "r" },
    { "id": "prg-c000", "bus": "cpu", "range": "$C000-$DFFF", "storage": "prg", "size": 8192, "initial": -2, "access": "r" },
    { "id": "prg-e000", "bus": "cpu", "range": "$E000-$FFFF", "storage": "prg", "size": 8192, "initial": -1, "access": "r" },
    { "id": "chr-0000", "bus": "ppu", "range": "$0000-$03FF", "storage": ["chr", "chr-ram"], "size": 1024, "initial": 0, "access": "rw" },
    { "id": "chr-0400", "bus": "ppu", "range": "$0400-$07FF", "storage": ["chr", "chr-ram"], "size": 1024, "initial": 1, "access": "rw" },
    { "id": "chr-0800", "bus": "ppu", "range": "$0800-$0BFF", "storage": ["chr", "chr-ram"], "size": 1024, "initial": 2, "access": "rw" },
    { "id": "chr-0c00", "bus": "ppu", "range": "$0C00-$0FFF", "storage": ["chr", "chr-ram"], "size": 1024, "initial": 3, "access": "rw" },
    { "id": "chr-1000", "bus": "ppu", "range": "$1000-$13FF", "storage": ["chr", "chr-ram"], "size": 1024, "initial": 4, "access": "rw" },
    { "id": "chr-1400", "bus": "ppu", "range": "$1400-$17FF", "storage": ["chr", "chr-ram"], "size": 1024, "initial": 5, "access": "rw" },
    { "id": "chr-1800", "bus": "ppu", "range": "$1800-$1BFF", "storage": ["chr", "chr-ram"], "size": 1024, "initial": 6, "access": "rw" },
    { "id": "chr-1c00", "bus": "ppu", "range": "$1C00-$1FFF", "storage": ["chr", "chr-ram"], "size": 1024, "initial": 7, "access": "rw" },
    { "id": "prg-ram", "bus": "cpu", "range": "$6000-$7FFF", "storage": "prg-ram", "size": 8192, "initial": 0, "access": "rw" }
  ],
  "registers": [
    { "bus": "cpu", "range": "$8000-$FFFF", "write": true }
  ],
  "nametable": "header"
}
