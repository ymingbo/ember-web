{
  "id": "bf9096",
  "name": "Codemasters BF9096",
  "version": "1.0.0",
  "apiVersion": 1,
  "publisher": "Ember",
  "description": "Codemasters BF9096（mapper 232）：PRG 分 4 个 64K 块，$8000-$BFFF 写入选块（子 mapper 1 的位序交换），$C000-$FFFF 写入选块内 16K 的 bank；$8000 起 16K 可切换，$C000 起固定为块内最后一个 bank。",
  "host": ["fc"],
  "match": [
    { "mapper": 232 }
  ],
  "storage": [
    { "id": "prg", "kind": "rom", "from": "file.prg" },
    { "id": "chr", "kind": "rom", "from": "file.chr", "fallback": { "kind": "ram", "size": { "header": "chrRam", "default": 8192 } } },
    { "id": "prg-ram", "kind": "ram", "size": { "header": "prgAny", "default": 8192 } }
  ],
  "windows": [
    { "id": "prg-8000-16k", "bus": "cpu", "range": "$8000-$BFFF", "storage": "prg", "size": 16384, "initial": 0, "access": "r" },
    { "id": "prg-c000-16k", "bus": "cpu", "range": "$C000-$FFFF", "storage": "prg", "size": 16384, "initial": 3, "access": "r" },
    { "id": "chr-0000", "bus": "ppu", "range": "$0000-$1FFF", "storage": "chr", "size": 8192, "initial": 0, "access": "rw" },
    { "id": "prg-ram", "bus": "cpu", "range": "$6000-$7FFF", "storage": "prg-ram", "size": 8192, "initial": 0, "access": "rw" }
  ],
  "registers": [
    { "bus": "cpu", "range": "$8000-$FFFF", "write": true }
  ],
  "state": [
    { "name": "prgBlock", "bits": 2, "description": "外层块号" },
    { "name": "prgPage", "bits": 2, "description": "块内 16K 的 bank" }
  ],
  "nametable": "header"
}
