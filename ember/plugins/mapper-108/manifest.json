{
  "id": "mapper-108",
  "name": "Mapper 108",
  "version": "1.0.0",
  "apiVersion": 1,
  "publisher": "Ember",
  "description": "热门 FDS 转卡（mapper 108）：$8000-$FFFF 固定映射最后 4 个 8K bank；$6000-$7FFF 映射一个 8K 的 PRG ROM bank（没有 PRG RAM）；$8000-$8FFF、$A000-$AFFF 与 $F000 起的写入同时更新 PRG 与 CHR bank，其余写入只用位 0 更新 CHR bank。",
  "host": ["fc"],
  "match": [
    { "mapper": 108 }
  ],
  "storage": [
    { "id": "prg", "kind": "rom", "from": "file.prg" },
    { "id": "chr", "kind": "rom", "from": "file.chr", "fallback": { "kind": "ram", "size": { "header": "chrRam", "default": 8192 } } }
  ],
  "windows": [
    { "id": "prg-6000", "bus": "cpu", "range": "$6000-$7FFF", "storage": "prg", "size": 8192, "initial": 255, "access": "r" },
    { "id": "prg-8000", "bus": "cpu", "range": "$8000-$9FFF", "storage": "prg", "size": 8192, "initial": -4, "access": "r" },
    { "id": "prg-a000", "bus": "cpu", "range": "$A000-$BFFF", "storage": "prg", "size": 8192, "initial": -3, "access": "r" },
    { "id": "prg-c000", "bus": "cpu", "range": "$C000-$DFFF", "storage": "prg", "size": 8192, "initial": -2, "access": "r" },
    { "id": "prg-e000", "bus": "cpu", "range": "$E000-$FFFF", "storage": "prg", "size": 8192, "initial": -1, "access": "r" },
    { "id": "chr-0000", "bus": "ppu", "range": "$0000-$1FFF", "storage": "chr", "size": 8192, "initial": 0, "access": "rw" }
  ],
  "registers": [
    { "bus": "cpu", "range": "$8000-$FFFF", "write": true }
  ],
  "state": [
    { "name": "prgReg", "bits": 8, "description": "$6000 的 PRG bank" },
    { "name": "chrReg", "bits": 8, "description": "8K 的 CHR bank" }
  ],
  "nametable": "header"
}
