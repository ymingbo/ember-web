{
  "id": "nina01",
  "name": "NINA-001",
  "version": "1.0.0",
  "apiVersion": 1,
  "publisher": "Ember",
  "description": "NINA-001（mapper 34，有 CHR ROM 或子 mapper 1）：$7FFD 选 32K 的 PRG bank，$7FFE 与 $7FFF 选两个 4K 的 CHR bank；这三个地址的写入同时写进 $6000-$7FFF 的 PRG RAM。",
  "host": ["fc"],
  "match": [
    { "mapper": 34, "variant": 1 },
    { "mapper": 34, "variant": 0, "chr": "present" }
  ],
  "storage": [
    { "id": "prg", "kind": "rom", "from": "file.prg" },
    { "id": "chr", "kind": "rom", "from": "file.chr", "fallback": { "kind": "ram", "size": { "header": "chrRam", "default": 8192 } } },
    { "id": "prg-ram", "kind": "ram", "size": { "header": "prgAny", "default": 8192 } }
  ],
  "windows": [
    { "id": "prg-8000-32k", "bus": "cpu", "range": "$8000-$FFFF", "storage": "prg", "size": 32768, "initial": 0, "access": "r" },
    { "id": "chr-0000", "bus": "ppu", "range": "$0000-$0FFF", "storage": "chr", "size": 4096, "initial": 0, "access": "rw" },
    { "id": "chr-1000", "bus": "ppu", "range": "$1000-$1FFF", "storage": "chr", "size": 4096, "initial": 0, "access": "rw" },
    { "id": "prg-ram", "bus": "cpu", "range": "$6000-$7FFF", "storage": "prg-ram", "size": 8192, "initial": 0, "access": "rw" }
  ],
  "registers": [
    { "bus": "cpu", "range": "$7FFD-$7FFF", "write": true }
  ],
  "nametable": "header"
}
