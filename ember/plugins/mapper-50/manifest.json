{
  "id": "mapper-50",
  "name": "Mapper50",
  "version": "1.0.0",
  "apiVersion": 1,
  "publisher": "Ember",
  "description": "盗版卡（mapper 50）：$4020-$5FFF 里 $4020 写入的位重新排列后选 $C000 的 8K 页，$4120 写入位 0 为 1 时开始计数、4096 个 CPU 周期后发出一次 IRQ，为 0 时关闭并清零；$6000 固定为第 $F 页，$8000、$A000、$E000 固定为第 8、9、$B 页。",
  "host": ["fc"],
  "match": [
    { "mapper": 50 }
  ],
  "storage": [
    { "id": "prg", "kind": "rom", "from": "file.prg" },
    { "id": "chr", "kind": "rom", "from": "file.chr", "fallback": { "kind": "ram", "size": { "header": "chrRam", "default": 8192 } } },
    { "id": "prg-ram", "kind": "ram", "size": { "header": "prgAny", "default": 8192 } }
  ],
  "windows": [
    { "id": "prg-8000", "bus": "cpu", "range": "$8000-$9FFF", "storage": "prg", "size": 8192, "initial": 8, "access": "r" },
    { "id": "prg-a000", "bus": "cpu", "range": "$A000-$BFFF", "storage": "prg", "size": 8192, "initial": 9, "access": "r" },
    { "id": "prg-c000", "bus": "cpu", "range": "$C000-$DFFF", "storage": "prg", "size": 8192, "initial": 0, "access": "r" },
    { "id": "prg-e000", "bus": "cpu", "range": "$E000-$FFFF", "storage": "prg", "size": 8192, "initial": 11, "access": "r" },
    { "id": "prg-6000", "bus": "cpu", "range": "$6000-$7FFF", "storage": "prg", "size": 8192, "initial": 15, "access": "r" },
    { "id": "chr-0000", "bus": "ppu", "range": "$0000-$1FFF", "storage": "chr", "size": 8192, "initial": 0, "access": "rw" }
  ],
  "registers": [
    { "bus": "cpu", "range": "$4020-$5FFF", "write": true }
  ],
  "nametable": "header"
}
