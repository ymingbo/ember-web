{
  "id": "kaiser7017",
  "name": "Kaiser KS-7017",
  "version": "1.0.0",
  "apiVersion": 1,
  "publisher": "Ember",
  "description": "Kaiser KS-7017（mapper 303）：$4A00 页的写入地址位选 16K 程序页（$C000 固定第 2 页，需再写 $5100 页才生效），$4025 位 3 选镜像；$4020、$4021 写 16 位计数值（$4021 同时允许），计数器每周期减 1，减到 0 时发出一次 IRQ；读 $4030 返回并清除 IRQ。",
  "host": ["fc"],
  "match": [
    { "mapper": 303 }
  ],
  "storage": [
    { "id": "prg", "kind": "rom", "from": "file.prg" },
    { "id": "chr", "kind": "rom", "from": "file.chr", "fallback": { "kind": "ram", "size": { "header": "chrRam", "default": 8192 } } },
    { "id": "prg-ram", "kind": "ram", "size": { "header": "prgAny", "default": 8192 } }
  ],
  "windows": [
    { "id": "prg-8000-16k", "bus": "cpu", "range": "$8000-$BFFF", "storage": "prg", "size": 16384, "initial": 0, "access": "r" },
    { "id": "prg-c000-16k", "bus": "cpu", "range": "$C000-$FFFF", "storage": "prg", "size": 16384, "initial": 2, "access": "r" },
    { "id": "chr-0000", "bus": "ppu", "range": "$0000-$1FFF", "storage": "chr", "size": 8192, "initial": 0, "access": "rw" },
    { "id": "prg-ram", "bus": "cpu", "range": "$6000-$7FFF", "storage": "prg-ram", "size": 8192, "initial": 0, "access": "rw" }
  ],
  "registers": [
    { "bus": "cpu", "range": "$4020-$402F", "write": true },
    { "bus": "cpu", "range": "$4030", "read": true },
    { "bus": "cpu", "range": "$4031-$5FFF", "write": true }
  ],
  "nametable": "header"
}
