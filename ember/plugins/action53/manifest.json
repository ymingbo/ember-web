{
  "id": "action53",
  "name": "Action 53",
  "version": "1.0.0",
  "apiVersion": 1,
  "publisher": "Ember",
  "description": "Action 53（mapper 28）：多合一合集卡。$5000-$5FFF 写入选寄存器（0 为 CHR，1 为内层 PRG，2 为模式，3 为外层 PRG），$8000-$FFFF 写入该寄存器的值；PRG 以 16K 为单位，按游戏大小与模式组合内外层 bank；名称表由模式寄存器与镜像位决定。",
  "host": ["fc"],
  "match": [
    { "mapper": 28 }
  ],
  "storage": [
    { "id": "prg", "kind": "rom", "from": "file.prg" },
    { "id": "chr", "kind": "rom", "from": "file.chr", "fallback": { "kind": "ram", "size": { "header": "chrRam", "default": 8192 } } },
    { "id": "prg-ram", "kind": "ram", "size": { "header": "prgAny", "default": 8192 } }
  ],
  "windows": [
    { "id": "prg-8000-16k", "bus": "cpu", "range": "$8000-$BFFF", "storage": "prg", "size": 16384, "initial": 0, "access": "r" },
    { "id": "prg-c000-16k", "bus": "cpu", "range": "$C000-$FFFF", "storage": "prg", "size": 16384, "initial": "last", "access": "r" },
    { "id": "chr-0000", "bus": "ppu", "range": "$0000-$1FFF", "storage": "chr", "size": 8192, "initial": 0, "access": "rw" },
    { "id": "prg-ram", "bus": "cpu", "range": "$6000-$7FFF", "storage": "prg-ram", "size": 8192, "initial": 0, "access": "rw" }
  ],
  "registers": [
    { "bus": "cpu", "range": "$5000-$5FFF", "write": true },
    { "bus": "cpu", "range": "$8000-$FFFF", "write": true }
  ],
  "state": [
    { "name": "selectedReg", "bits": 2, "description": "当前选中的寄存器号" },
    { "name": "reg0", "bits": 8, "description": "寄存器 0：CHR bank" },
    { "name": "reg1", "bits": 8, "description": "寄存器 1：内层 PRG bank" },
    { "name": "reg2", "bits": 8, "description": "寄存器 2：模式（镜像、PRG 模式、游戏大小）" },
    { "name": "reg3", "bits": 8, "description": "寄存器 3：外层 PRG bank" },
    { "name": "mirroringBit", "bits": 1, "description": "模式寄存器不控制镜像时使用的镜像位" }
  ],
  "nametable": "header"
}
