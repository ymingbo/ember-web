{
  "id": "cp-rom",
  "name": "CPROM",
  "version": "1.0.0",
  "apiVersion": 1,
  "publisher": "Ember",
  "description": "CPROM（mapper 13）：PRG 固定 32K；CHR 是 16K 的 RAM，$0000 起 4K 固定为第一页，$1000 起 4K 由写入值的低 2 位选页；名称表固定垂直镜像。",
  "host": ["fc"],
  "match": [
    { "mapper": 13 }
  ],
  "storage": [
    { "id": "prg", "kind": "rom", "from": "file.prg" },
    { "id": "chr", "kind": "rom", "from": "file.chr", "fallback": { "kind": "ram", "size": { "header": "chrRam", "default": 16384 } } },
    { "id": "prg-ram", "kind": "ram", "size": { "header": "prgAny", "default": 8192 } }
  ],
  "windows": [
    { "id": "prg-8000-32k", "bus": "cpu", "range": "$8000-$FFFF", "storage": "prg", "size": 32768, "initial": 0, "access": "r" },
    { "id": "chr-0000", "bus": "ppu", "range": "$0000-$0FFF", "storage": "chr", "size": 4096, "initial": 0, "access": "rw" },
    { "id": "chr-1000", "bus": "ppu", "range": "$1000-$1FFF", "storage": "chr", "size": 4096, "initial": 1, "access": "rw" },
    { "id": "prg-ram", "bus": "cpu", "range": "$6000-$7FFF", "storage": "prg-ram", "size": 8192, "initial": 0, "access": "rw" }
  ],
  "registers": [
    { "bus": "cpu", "range": "$8000-$FFFF", "write": { "state": "chrBank", "bank": [{ "window": "chr-1000", "mask": 3 }] } }
  ],
  "state": [
    { "name": "chrBank", "bits": 2, "description": "$1000 起 4K 的 CHR RAM 页号" }
  ],
  "nametable": "vertical"
}
