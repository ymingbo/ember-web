{
  "id": "t262",
  "name": "T-262",
  "version": "1.0.0",
  "apiVersion": 1,
  "publisher": "Ember",
  "description": "T-262 合集卡（mapper 265）：第一次写入锁定前由地址决定外层 bank、模式与名称表镜像，地址位 13 为 1 时锁定；写入值的低 3 位选内层 bank；$8000 起 16K 为外层加内层，$C000 起 16K 在模式 1 时同样、否则固定为外层的第 7 个 bank。",
  "host": ["fc"],
  "match": [
    { "mapper": 265 }
  ],
  "storage": [
    { "id": "prg", "kind": "rom", "from": "file.prg" },
    { "id": "chr", "kind": "rom", "from": "file.chr", "fallback": { "kind": "ram", "size": { "header": "chrRam", "default": 8192 } } },
    { "id": "prg-ram", "kind": "ram", "size": { "header": "prgAny", "default": 8192 } }
  ],
  "windows": [
    { "id": "prg-8000-16k", "bus": "cpu", "range": "$8000-$BFFF", "storage": "prg", "size": 16384, "initial": 0, "access": "r" },
    { "id": "prg-c000-16k", "bus": "cpu", "range": "$C000-$FFFF", "storage": "prg", "size": 16384, "initial": 7, "access": "r" },
    { "id": "chr-0000", "bus": "ppu", "range": "$0000-$1FFF", "storage": "chr", "size": 8192, "initial": 0, "access": "rw" },
    { "id": "prg-ram", "bus": "cpu", "range": "$6000-$7FFF", "storage": "prg-ram", "size": 8192, "initial": 0, "access": "rw" }
  ],
  "registers": [
    { "bus": "cpu", "range": "$8000-$FFFF", "write": true }
  ],
  "state": [
    { "name": "locked", "bits": 1, "description": "外层设置是否已锁定" },
    { "name": "base", "bits": 8, "description": "外层 bank" },
    { "name": "bank", "bits": 3, "description": "内层 bank" },
    { "name": "mode", "bits": 1, "description": "模式：1 时两个窗口取同一个内层 bank" }
  ],
  "nametable": "header"
}
