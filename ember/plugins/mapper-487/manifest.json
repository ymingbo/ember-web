{
  "id": "mapper-487",
  "name": "Mapper 487",
  "version": "1.0.0",
  "apiVersion": 1,
  "publisher": "Ember",
  "description": "合集卡（mapper 487）：$4100-$5FFF 写入时（地址位 8 为 1）位 7 为 1 写寄存器 1（外层与模式），否则在未锁定时写寄存器 0 的低 4 位；寄存器 1 的位 5 为 1 时 $8000-$FFFF 的写入以 Color Dreams 方式写寄存器 0；PRG 32K、CHR 8K 的 bank 由两个寄存器拼成；位 7 选名称表镜像（1 为水平）。",
  "host": ["fc"],
  "match": [
    { "mapper": 487 }
  ],
  "storage": [
    { "id": "prg", "kind": "rom", "from": "file.prg" },
    { "id": "chr", "kind": "rom", "from": "file.chr", "fallback": { "kind": "ram", "size": { "header": "chrRam", "default": 8192 } } },
    { "id": "prg-ram", "kind": "ram", "size": { "header": "prgAny", "default": 8192 } }
  ],
  "windows": [
    { "id": "prg-8000-32k", "bus": "cpu", "range": "$8000-$FFFF", "storage": "prg", "size": 32768, "initial": 0, "access": "r" },
    { "id": "chr-0000", "bus": "ppu", "range": "$0000-$1FFF", "storage": "chr", "size": 8192, "initial": 0, "access": "rw" },
    { "id": "prg-ram", "bus": "cpu", "range": "$6000-$7FFF", "storage": "prg-ram", "size": 8192, "initial": 0, "access": "rw" }
  ],
  "registers": [
    { "bus": "cpu", "range": "$4100-$5FFF", "write": true },
    { "bus": "cpu", "range": "$8000-$FFFF", "write": true }
  ],
  "state": [
    { "name": "reg0", "bits": 8, "initial": 0, "description": "寄存器 0（内层）" },
    { "name": "reg1", "bits": 8, "initial": 0, "description": "寄存器 1（外层与模式）" }
  ],
  "nametable": "header"
}
