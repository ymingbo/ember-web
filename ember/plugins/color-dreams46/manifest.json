{
  "id": "color-dreams46",
  "name": "Color Dreams（mapper 46）",
  "version": "1.0.0",
  "apiVersion": 1,
  "publisher": "Ember",
  "description": "Color Dreams 的 15-in-1 合集卡（mapper 46）：$6000-$7FFF 写入第一个寄存器、$8000-$FFFF 写入第二个寄存器；PRG 32K 的 bank 由两个寄存器的低位拼成，CHR 8K 的 bank 同理；任何复位都把两个寄存器清零。",
  "host": ["fc"],
  "match": [
    { "mapper": 46 }
  ],
  "storage": [
    { "id": "prg", "kind": "rom", "from": "file.prg" },
    { "id": "chr", "kind": "rom", "from": "file.chr", "fallback": { "kind": "ram", "size": { "header": "chrRam", "default": 8192 } } },
    { "id": "prg-ram", "kind": "ram", "size": { "header": "prgAny", "default": 8192 } }
  ],
  "windows": [
    { "id": "prg-8000-32k", "bus": "cpu", "range": "$8000-$FFFF", "storage": "prg", "size": 32768, "initial": 0, "access": "r" },
    { "id": "chr-0000", "bus": "ppu", "range": "$0000-$1FFF", "storage": "chr", "size": 8192, "initial": 0, "access": "rw" },
    { "id": "prg-ram", "bus": "cpu", "range": "$6000-$7FFF", "storage": "prg-ram", "size": 8192, "initial": 0, "access": "rw" }
  ],
  "registers": [
    { "bus": "cpu", "range": "$6000-$FFFF", "write": true }
  ],
  "state": [
    { "name": "reg0", "bits": 8, "description": "$6000-$7FFF 写入的寄存器" },
    { "name": "reg1", "bits": 8, "description": "$8000-$FFFF 写入的寄存器" }
  ],
  "nametable": "header"
}
