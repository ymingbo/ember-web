{
  "id": "rt01",
  "name": "RT-01",
  "version": "1.0.0",
  "apiVersion": 1,
  "publisher": "Ember",
  "description": "RT-01 测试卡（mapper 328）：PRG 固定 32K，CHR 为 4 个 2K 窗口；$CE80-$CEFF 与 $FE80-$FEFF 的读出是随机值（位 0、2、3 随机，其余为 1），其余地址读 PRG；没有可写寄存器。",
  "host": ["fc"],
  "match": [
    { "mapper": 328 }
  ],
  "storage": [
    { "id": "prg", "kind": "rom", "from": "file.prg" },
    { "id": "chr", "kind": "rom", "from": "file.chr", "fallback": { "kind": "ram", "size": { "header": "chrRam", "default": 8192 } } },
    { "id": "prg-ram", "kind": "ram", "size": { "header": "prgAny", "default": 8192 } }
  ],
  "windows": [
    { "id": "prg-8000-16k", "bus": "cpu", "range": "$8000-$BFFF", "storage": "prg", "size": 16384, "initial": 0, "access": "r" },
    { "id": "prg-c000-16k", "bus": "cpu", "range": "$C000-$FFFF", "storage": "prg", "size": 16384, "initial": 0, "access": "r" },
    { "id": "chr-0000", "bus": "ppu", "range": "$0000-$07FF", "storage": "chr", "size": 2048, "initial": 0, "access": "rw" },
    { "id": "chr-0800", "bus": "ppu", "range": "$0800-$0FFF", "storage": "chr", "size": 2048, "initial": 0, "access": "rw" },
    { "id": "chr-1000", "bus": "ppu", "range": "$1000-$17FF", "storage": "chr", "size": 2048, "initial": 0, "access": "rw" },
    { "id": "chr-1800", "bus": "ppu", "range": "$1800-$1FFF", "storage": "chr", "size": 2048, "initial": 0, "access": "rw" },
    { "id": "prg-ram", "bus": "cpu", "range": "$6000-$7FFF", "storage": "prg-ram", "size": 8192, "initial": 0, "access": "rw" }
  ],
  "registers": [
    { "bus": "cpu", "range": "$CE80-$CEFF", "read": true },
    { "bus": "cpu", "range": "$FE80-$FEFF", "read": true }
  ],
  "nametable": "header"
}
