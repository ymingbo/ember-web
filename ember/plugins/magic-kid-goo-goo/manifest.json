{
  "id": "magic-kid-goo-goo",
  "name": "Magic Kid GooGoo",
  "version": "1.0.0",
  "apiVersion": 1,
  "publisher": "Ember",
  "description": "Magic Kid GooGoo（mapper 190）：$8000 起 16K 可切换，$C000 起 16K 固定为第一个 bank；$8000-$9FFF 写入选前 8 个 bank，$C000-$DFFF 写入选后 8 个 bank；$A000 与 $E000 起的写入选 4 个 2K 的 CHR bank（地址低 2 位选窗口）；名称表固定垂直镜像。",
  "host": ["fc"],
  "match": [
    { "mapper": 190 }
  ],
  "storage": [
    { "id": "prg", "kind": "rom", "from": "file.prg" },
    { "id": "chr", "kind": "rom", "from": "file.chr", "fallback": { "kind": "ram", "size": { "header": "chrRam", "default": 8192 } } },
    { "id": "prg-ram", "kind": "ram", "size": { "header": "prgAny", "default": 8192 } }
  ],
  "windows": [
    { "id": "prg-8000-16k", "bus": "cpu", "range": "$8000-$BFFF", "storage": "prg", "size": 16384, "initial": 0, "access": "r" },
    { "id": "prg-c000-16k", "bus": "cpu", "range": "$C000-$FFFF", "storage": "prg", "size": 16384, "initial": 0, "access": "r" },
    { "id": "chr-0000", "bus": "ppu", "range": "$0000-$07FF", "storage": "chr", "size": 2048, "initial": 0, "access": "rw" },
    { "id": "chr-0800", "bus": "ppu", "range": "$0800-$0FFF", "storage": "chr", "size": 2048, "initial": 1, "access": "rw" },
    { "id": "chr-1000", "bus": "ppu", "range": "$1000-$17FF", "storage": "chr", "size": 2048, "initial": 2, "access": "rw" },
    { "id": "chr-1800", "bus": "ppu", "range": "$1800-$1FFF", "storage": "chr", "size": 2048, "initial": 3, "access": "rw" },
    { "id": "prg-ram", "bus": "cpu", "range": "$6000-$7FFF", "storage": "prg-ram", "size": 8192, "initial": 0, "access": "rw" }
  ],
  "registers": [
    { "bus": "cpu", "range": "$8000-$FFFF", "write": true }
  ],
  "nametable": "vertical"
}
