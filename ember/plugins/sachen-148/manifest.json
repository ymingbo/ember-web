{
  "id": "sachen-148",
  "name": "Sachen 148",
  "version": "1.0.0",
  "apiVersion": 1,
  "publisher": "Ember",
  "description": "Sachen SA-008-A（mapper 148）：$8000-$FFFF 写入值的位 3 选 32K 的 PRG bank，低 3 位选 8K 的 CHR bank；有总线冲突。",
  "host": ["fc"],
  "busConflict": true,
  "match": [
    { "mapper": 148 }
  ],
  "storage": [
    { "id": "prg", "kind": "rom", "from": "file.prg" },
    { "id": "chr", "kind": "rom", "from": "file.chr", "fallback": { "kind": "ram", "size": { "header": "chrRam", "default": 8192 } } },
    { "id": "prg-ram", "kind": "ram", "size": { "header": "prgAny", "default": 8192 } }
  ],
  "windows": [
    { "id": "prg-8000-32k", "bus": "cpu", "range": "$8000-$FFFF", "storage": "prg", "size": 32768, "initial": 0, "access": "r" },
    { "id": "chr-0000", "bus": "ppu", "range": "$0000-$1FFF", "storage": "chr", "size": 8192, "initial": 0, "access": "rw" },
    { "id": "prg-ram", "bus": "cpu", "range": "$6000-$7FFF", "storage": "prg-ram", "size": 8192, "initial": 0, "access": "rw" }
  ],
  "registers": [
    { "bus": "cpu", "range": "$8000-$FFFF", "write": { "state": "register", "bank": [{ "window": "prg-8000-32k", "shift": 3, "mask": 1 },{ "window": "chr-0000", "shift": 0, "mask": 7 }] } }
  ],
  "state": [
    { "name": "register", "bits": 8, "description": "最后写入的值（位 3 为 PRG bank，低 3 位为 CHR bank）" }
  ],
  "nametable": "header"
}
