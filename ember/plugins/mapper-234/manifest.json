{
  "id": "mapper-234",
  "name": "Mapper 234",
  "version": "1.0.0",
  "apiVersion": 1,
  "publisher": "Ember",
  "description": "Maxi 15（mapper 234）：读写 $FF80-$FF9F 在寄存器 0 为 0 时载入它（位 6 选 NINA-03 或 CNROM 的 PRG 与 CHR 拼法，位 7 选名称表镜像），读写 $FFE8-$FFF8 载入寄存器 1；读出的值同样会载入；有总线冲突；PRG 32K、CHR 8K。",
  "host": ["fc"],
  "busConflict": true,
  "match": [
    { "mapper": 234 }
  ],
  "storage": [
    { "id": "prg", "kind": "rom", "from": "file.prg" },
    { "id": "chr", "kind": "rom", "from": "file.chr", "fallback": { "kind": "ram", "size": { "header": "chrRam", "default": 8192 } } },
    { "id": "prg-ram", "kind": "ram", "size": { "header": "prgAny", "default": 8192 } }
  ],
  "windows": [
    { "id": "prg-8000-32k", "bus": "cpu", "range": "$8000-$FFFF", "storage": "prg", "size": 32768, "initial": 0, "access": "r" },
    { "id": "chr-0000", "bus": "ppu", "range": "$0000-$1FFF", "storage": "chr", "size": 8192, "initial": 0, "access": "rw" },
    { "id": "prg-ram", "bus": "cpu", "range": "$6000-$7FFF", "storage": "prg-ram", "size": 8192, "initial": 0, "access": "rw" }
  ],
  "registers": [
    { "bus": "cpu", "range": "$FF80-$FF9F", "read": true, "write": true },
    { "bus": "cpu", "range": "$FFE8-$FFF8", "read": true, "write": true }
  ],
  "state": [
    { "name": "reg0", "bits": 8, "description": "寄存器 0（只在为 0 时可写）" },
    { "name": "reg1", "bits": 8, "description": "寄存器 1" }
  ],
  "nametable": "header"
}
