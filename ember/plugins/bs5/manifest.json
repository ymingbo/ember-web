{
  "id": "bs5",
  "name": "BS-5",
  "version": "1.0.0",
  "apiVersion": 1,
  "publisher": "Ember",
  "description": "BS-5（mapper 286）：$8000-$9FFF 的地址位 11-10 选 2K 图案页槽、低 5 位选页；$A000-$BFFF 的同样槽选 8K 程序页（低 4 位），但只有地址位（DIP 值 + 4）为 1 时才接受。",
  "host": ["fc"],
  "match": [
    { "mapper": 286 }
  ],
  "storage": [
    { "id": "prg", "kind": "rom", "from": "file.prg" },
    { "id": "chr", "kind": "rom", "from": "file.chr", "fallback": { "kind": "ram", "size": { "header": "chrRam", "default": 8192 } } }
  ],
  "windows": [
    { "id": "prg-8000", "bus": "cpu", "range": "$8000-$9FFF", "storage": "prg", "size": 8192, "initial": -1, "access": "r" },
    { "id": "prg-a000", "bus": "cpu", "range": "$A000-$BFFF", "storage": "prg", "size": 8192, "initial": -1, "access": "r" },
    { "id": "prg-c000", "bus": "cpu", "range": "$C000-$DFFF", "storage": "prg", "size": 8192, "initial": -1, "access": "r" },
    { "id": "prg-e000", "bus": "cpu", "range": "$E000-$FFFF", "storage": "prg", "size": 8192, "initial": -1, "access": "r" },
    { "id": "chr-0000", "bus": "ppu", "range": "$0000-$07FF", "storage": "chr", "size": 2048, "initial": -1, "access": "rw" },
    { "id": "chr-0800", "bus": "ppu", "range": "$0800-$0FFF", "storage": "chr", "size": 2048, "initial": -1, "access": "rw" },
    { "id": "chr-1000", "bus": "ppu", "range": "$1000-$17FF", "storage": "chr", "size": 2048, "initial": -1, "access": "rw" },
    { "id": "chr-1800", "bus": "ppu", "range": "$1800-$1FFF", "storage": "chr", "size": 2048, "initial": -1, "access": "rw" }
  ],
  "registers": [
    { "bus": "cpu", "range": "$8000-$FFFF", "write": true }
  ],
  "settings": [
    { "key": "dip", "label": "DIP 开关", "kind": "choice", "default": "0", "description": "卡带上 2 个 DIP 开关的位置。", "options": [{ "value": "0", "label": "0" },{ "value": "1", "label": "1" },{ "value": "2", "label": "2" },{ "value": "3", "label": "3" }] }
  ],
  "nametable": "header"
}
