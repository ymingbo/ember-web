{
  "id": "nsf-cart31",
  "name": "NSF 合集卡",
  "version": "1.0.0",
  "apiVersion": 1,
  "publisher": "Ember",
  "description": "NSF 合集卡（mapper 31）：$8000-$FFFF 分成 8 个 4K 的 PRG 窗口，$5000-$5FFF 写入时地址的低 3 位选窗口、写入值选 4K 的 bank；上电只有最后一个窗口映射到最后一个 bank，其余窗口没有映射；CHR 是 8K。",
  "host": ["fc"],
  "match": [
    { "mapper": 31 }
  ],
  "storage": [
    { "id": "prg", "kind": "rom", "from": "file.prg" },
    { "id": "chr", "kind": "rom", "from": "file.chr", "fallback": { "kind": "ram", "size": { "header": "chrRam", "default": 8192 } } },
    { "id": "prg-ram", "kind": "ram", "size": { "header": "prgAny", "default": 8192 } }
  ],
  "windows": [
    { "id": "prg-8000", "bus": "cpu", "range": "$8000-$8FFF", "storage": "prg", "size": 4096, "initial": 0, "access": "r" },
    { "id": "prg-9000", "bus": "cpu", "range": "$9000-$9FFF", "storage": "prg", "size": 4096, "initial": 0, "access": "r" },
    { "id": "prg-a000", "bus": "cpu", "range": "$A000-$AFFF", "storage": "prg", "size": 4096, "initial": 0, "access": "r" },
    { "id": "prg-b000", "bus": "cpu", "range": "$B000-$BFFF", "storage": "prg", "size": 4096, "initial": 0, "access": "r" },
    { "id": "prg-c000", "bus": "cpu", "range": "$C000-$CFFF", "storage": "prg", "size": 4096, "initial": 0, "access": "r" },
    { "id": "prg-d000", "bus": "cpu", "range": "$D000-$DFFF", "storage": "prg", "size": 4096, "initial": 0, "access": "r" },
    { "id": "prg-e000", "bus": "cpu", "range": "$E000-$EFFF", "storage": "prg", "size": 4096, "initial": 0, "access": "r" },
    { "id": "prg-f000", "bus": "cpu", "range": "$F000-$FFFF", "storage": "prg", "size": 4096, "initial": 0, "access": "r" },
    { "id": "chr-0000", "bus": "ppu", "range": "$0000-$1FFF", "storage": "chr", "size": 8192, "initial": 0, "access": "rw" },
    { "id": "prg-ram", "bus": "cpu", "range": "$6000-$7FFF", "storage": "prg-ram", "size": 8192, "initial": 0, "access": "rw" }
  ],
  "registers": [
    { "bus": "cpu", "range": "$5000-$5FFF", "write": true }
  ],
  "nametable": "header"
}
