{
  "id": "txc22211-a",
  "name": "TXC 22211 A",
  "version": "1.0.0",
  "apiVersion": 1,
  "publisher": "Ember",
  "description": "TXC 22211 A（mapper 132）：$4020-$5FFF 写入 TXC 芯片（低 4 位），$8000-$FFFF 写入锁存输出：位 2 选 32K 程序页，位 1-0 选 8K 图案页；读 $4100 起的奇偶地址得芯片累加器（低 4 位）。",
  "host": ["fc"],
  "match": [
    { "mapper": 132 }
  ],
  "storage": [
    { "id": "prg", "kind": "rom", "from": "file.prg" },
    { "id": "chr", "kind": "rom", "from": "file.chr", "fallback": { "kind": "ram", "size": { "header": "chrRam", "default": 8192 } } }
  ],
  "windows": [
    { "id": "prg-8000-32k", "bus": "cpu", "range": "$8000-$FFFF", "storage": "prg", "size": 32768, "initial": 0, "access": "r" },
    { "id": "chr-0000", "bus": "ppu", "range": "$0000-$1FFF", "storage": "chr", "size": 8192, "initial": 0, "access": "rw" }
  ],
  "registers": [
    { "bus": "cpu", "range": "$4020-$5FFF", "read": true, "write": true },
    { "bus": "cpu", "range": "$8000-$FFFF", "write": true }
  ],
  "nametable": "header"
}
