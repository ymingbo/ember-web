{
  "name": "ember",
  "productName": "Ember",
  "version": "0.3.9",
  "private": true,
  "description": "Ember：FC 与学习机模拟器，Win32 原生外壳与 C++ 核心。",
  "author": "sungbin <sungbin@3578.cn>",
  "license": "GPL-3.0-only",
  "scripts": {
    "schema": "node tools/schema-gen/schema-gen.mjs",
    "core:test": "node tools/build/test-core.mjs",
    "win32:build": "node tools/build/build-win32.mjs",
    "win32:test": "node tools/build/test-win32.mjs",
    "win32:start": "node tools/build/start-win32.mjs",
    "win32:shaders": "node tools/build/gen-screen-shaders.mjs",
    "win32:check": "node tools/check/check-win32-ui-kit.mjs && node tools/check/check-win32-imports.mjs",
    "win32:reference": "node win32/ui-kit/tools/reference/run-compare.mjs",
    "win32:probe-package": "node tools/build/pack-win32-probe.mjs",
    "plugins:pack": "node tools/build/pack-plugins.mjs",
    "resources:pack": "node tools/build/pack-resources.mjs",
    "package:win": "node tools/release/package-win32.mjs",
    "update:keygen": "node tools/release/keygen.mjs",
    "update:publish": "node tools/release/publish-update.mjs",
    "help:build": "node tools/build/build-help.mjs",
    "boundaries": "npm run schema && node tools/check/check-modules.mjs",
    "vscode:check": "npm --prefix ../vscode run check",
    "test": "npm run schema && vitest run",
    "lint": "oxlint --deny-warnings tools test win32/ui-kit/tools",
    "check": "npm run lint && npm run boundaries && npm run help:build && vitest run && npm run core:test && npm run vscode:check && npm run win32:check",
    "ffmpeg:tools": "node tools/ffmpeg/install-build-tools.mjs",
    "ffmpeg:build": "node tools/ffmpeg/build-ffmpeg.mjs",
    "ffmpeg:check": "node tools/ffmpeg/check-ffmpeg.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.1",
    "oxlint": "^1.90.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.5",
    "vitepress": "^1.6.4",
    "vitest": "^5.1.0"
  }
}
